{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "AspApp.Controllers.AuthorizationController": "Information"
    }
  },

  "AllowedHosts": "*",
  "HostName": "https://localhost",

  "Kafka": {
    "BootstrapServer": "kafka:9092",
    "LogTopic": "log",
    "EmailTopic": "email"
  },

  "Postgres": {
    "ConnectionString": {
      "Identity": "Host=postgres;Database=IdentityDb;Username=postgres;Password=Password;",
      "DataProtection": "Host=postgres;Database=DataProtectionDb;Username=postgres;Password=Password;"
    }
  },

  "OidcServerEncryptionKey": "YourEncryptionKey"

}
